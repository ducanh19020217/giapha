generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id            String   @id @default(uuid())
  name          String
  gender        String
  birthDate     String?
  isDeceased    Boolean  @default(false)
  deathDate     String?
  generation    Int
  birthOrder    Int
  academicLevel String?
  career        String?
  biography     String?
  avatarUrl     String?

  fatherId      String?
  motherId      String?

  // Relations
  father        Member?  @relation("FatherChildren", fields: [fatherId], references: [id])
  mother        Member?  @relation("MotherChildren", fields: [motherId], references: [id])
  
  childrenAsFather Member[] @relation("FatherChildren")
  childrenAsMother Member[] @relation("MotherChildren")

  // Many-to-many through SpouseRelation
  spouses       SpouseRelation[] @relation("MemberSpouses")
  spouseOf      SpouseRelation[] @relation("SpouseOfMember")

  achievements  String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SpouseRelation {
  id         String  @id @default(uuid())
  
  memberId   String
  member     Member  @relation("MemberSpouses", fields: [memberId], references: [id])
  
  spouseId   String
  spouse     Member  @relation("SpouseOfMember", fields: [spouseId], references: [id])
  
  isPrimary  Boolean @default(true)
  order      Int     @default(1)

  @@unique([memberId, spouseId])
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  VIEWER
}
